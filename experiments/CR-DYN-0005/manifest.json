  "owner": "xilanhua12138",
  "title": "CoinRun 4/16/32 history-context ablation",
  "kind": "confirmatory",
  "question": "On one checkpoint and identical futures, how do 4, 16, and 32 history frames affect 16-frame rollout quality?",
  "reason": "All completed local evaluations used four context frames, so the value of longer available history remains unknown.",
  "hypothesis": "Longer history improves or preserves controlled rollout PSNR and SSIM by better identifying velocity and recent action effects.",
  "falsification": "The controlled 16/32-frame arms reduce both metrics or the future identity contract cannot be satisfied.",
  "baseline_id": "CR-DYN-0004",
  "depends_on": [
    "CR-DYN-0004"
  ],
  "controlled_variable": {
    "name": "history_context_frames",
    "values": [
      4,
      16,
      32
    ]
  },
  "constants": {
    "checkpoint": "selected once after CR-DYN-0004",
    "selection_rule": "highest held-out mean_frame_psnr_db; mean_ssim tiebreaker",
    "future_frames": "identical byte content across all arms",
    "future_actions": "identical across all arms",
    "horizon": 16,
    "videos": 8,
    "seed": 4242,
    "metric_target": "tokenizer_decoded_ground_truth"
  },
  "source": {
    "repository": "https://github.com/xilanhua12138/open-dreamer",
